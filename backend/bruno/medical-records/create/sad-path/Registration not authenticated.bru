meta {
  name: Registration not authenticated
  type: http
  seq: 1
}

post {
  url: {{baseurl}}/medical_record/create_record/21
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "blood_type": "U+", // este error no debería mostrarse al no estar autorizado
    "eps": "Sura",
    "allergies": "Piña",
    "chronic_diseases": "Diabetes",
    "physical_restrictions": "Requiere una silla de ruedas",
    "surgical_history": "Apendicectomía",
    "vaccines_detail": [],
    "medications_detail": []
  }
  
}

tests {
  test("Validar petición fallida", function () {
    expect(res.status).to.equal(403);
  });
  
  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("ERROR: no permitido.");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Nombre:** Registro no autenticado
  
  **Endpoint:** /api/v1/medical_record/create_record/{id}
  
  **HU relacionadas:** HU-INN-1.1
  
  **Descripción:** Comprobar que el endpoint de creación de registros medicos recibe y responde correctamente a una petición válida por un miembro no autenticado/que no ha iniciado sesión.
  
  Es importante que, antes que cualquier otro error, siempre se muestren primero errores de autorización y autenticación, para evitar que se filtre información al exterior.
  
  **Respuesta esperada:** Retorna el código 403 (forbidden) y un mensaje de error.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-08
  
}
