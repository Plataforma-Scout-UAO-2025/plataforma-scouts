meta {
  name: Successful registration without filling in optional fields
  type: http
  seq: 2
}

post {
  url: {{baseurl}}api/v1/medical_record/create_record
  body: json
  auth: none
}

body:json {
  {
    "member_id": 123,
    "blood_type": "AB+",
    "eps": "Sura",
    "allergies": "",
    "chronic_diseases": "",
    "physical_restrictions": "",
    "surgical_history": "",
    "vaccines_detail": [],
    "medications_detail": []
  }
  
}

tests {
  test("Validar petición exitosa", function () {
    expect(res.status).to.equal("200");
  });
  
  test("Validar mensaje de exito", function () {
    expect(res.body.message).to.equal("Registro generado con exito.");
  });
  
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Registro exitoso sin campos opcionales
  
  **Endpoint:** /api/v1/medical_record/create_record
  
  **HU relacionadas:** HU-INN-1.1
  
  **Descripción:** Comprobar que el endpoint de creación de registros medicos recibe y responde correctamente a una petición con solo los campos obligatorios, con valores válidos y con la sesión iniciada.
  
  **Respuesta esperada:** Retorna el código 200 y un body con un mensaje de exito.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
