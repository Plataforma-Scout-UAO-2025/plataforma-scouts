meta {
  name: Successful listing
  type: http
  seq: 12
}

get {
  url: {{baseurl}}api/v1/medical_record/list_record/1
  body: json
  auth: none
}

tests {
  test("Validar petición exitosa", function () {
    expect(res.status).to.equal("200");
  });
  
  test("Validar tipos de todos los campos", function () {
    expect(res.body.medical_record_id).to.be.a('bigint');
    expect(res.body.member_id).to.be.a('bigint');
  
    expect(res.body.blood_type).to.be.a('string');
    expect(res.body.eps).to.be.a('string');
    expect(res.body.allergies).to.be.a('string');
    expect(res.body.chronic_diseases).to.be.a('string');
    expect(res.body.physical_restrictions).to.be.a('string');
    expect(res.body.surgical_history).to.be.a('string');
  
    expect(res.body.active).to.be.a('boolean');
    
    expect(res.body.vaccines_detail).to.be.a('array').that.is.not.empty;
    expect(res.body.vaccines_detail[0].name).to.be.a('string');
    expect(res.body.vaccines_detail[0].date).to.be.a('date');
  
    expect(res.body.medications_detail).to.be.a('array').that.is.not.empty;
    expect(res.body.medications_detail[0].name).to.be.a('string');
    expect(res.body.medications_detail[0].dose).to.be.a('string');
    expect(res.body.medications_detail[0].frecuency).to.be.a('string');
  
    expect(res.body.created_at).to.be.a('date');
    expect(res.body.updated_at).to.be.a('date');
  });
  
  test("Validar campos obligatorios", function () {
    expect(res.body.medical_record_id).to.be.at.least(0);
    expect(res.body.member_id).to.be.at.least(0);
  
    expect(res.body.blood_type).to.equal("AB+");
    expect(res.body.eps).to.equal("Sura");
  });
  
  test("Validar campos no obligatorios", function () {
    expect(res.body.allergies).to.equal("Piña");
    expect(res.body.chronic_diseases).to.equal("Diabetes");
    expect(res.body.physical_restrictions).to.equal("Requiere una silla de ruedas");
    expect(res.body.surgical_history).to.equal("Apendicectomía");
  
    expect(res.body.vaccines_detail).to.be.not.empty;
    expect(res.body.vaccines_detail[0]).to.include({name:"COVID-19 (Pfizer)",date:"2022-04-23T18:25:43.511Z"});
  
    expect(res.body.medications_detail).to.be.not.empty;
    expect(res.body.medications_detail[0]).to.include({name:"Aspirina",dose:"5 mg",frecuency:"2 veces al día"});
  });
  
  test("Validar categorias válidas de tipo de sangre", function () {
    const tiposSangreValidos = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    expect(res.body.blood_type).to.be.oneOf(tiposSangreValidos);
  });
  
  test("Validar limite de caracteres", function () {
    expect(res.body.eps).to.have.lengthOf.at.most(50);
    expect(res.body.allergies).to.have.lengthOf.at.most(1000);
    expect(res.body.chronic_diseases).to.have.lengthOf.at.most(1000);
    expect(res.body.physical_restrictions).to.have.lengthOf.at.most(1000);
    expect(res.body.surgical_history).to.have.lengthOf.at.most(1000);
  
    expect(res.body.vaccines_detail).to.be.not.empty;
    expect(res.body.vaccines_detail[0].name).to.have.lengthOf.at.most(50);
  
    expect(res.body.medications_detail).to.be.not.empty;
    expect(res.body.medications_detail[0].name).to.have.lengthOf.at.most(50);
    expect(res.body.medications_detail[0].dose).to.have.lengthOf.at.most(100);
    expect(res.body.medications_detail[0].frecuency).to.have.lengthOf.at.most(100);
  });
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Listado exitoso
  
  **Endpoint:** /api/v1/medical_record/list_record/{id}
  
  **HU relacionadas:** HU-INN-2.1 HU-INN-2.2
  
  **Descripción:** Comprobar que el endpoint de listado de registros medicos recibe y responde correctamente a una petición con valores válidos y por un miembro con los permisos requeridos.
  
  **Respuesta esperada:** Retorna el código 200 y el objeto de registro médico.
  
  **Estructura del body de salida:**
  
  ```
  res.body {
  
    "medical_record_id": bigint,
    
    "member_id": bigint,
  
    "blood_type": string,
  
    "eps": string,
    
    "allergies": string,
    
    "chronic_diseases": string,
    
    "physical_restrictions": string,
    
    "surgical_history": string,
    
    "active": bool,
    
    "vaccines_detail": [{
      "name": string,
      "date": date
    }],
    
    "medications_detail": [{
      "name": string,
      "dose": string,
      "frecuency": string
    }],
    
    "created_at": date,
    
    "updated_at": date,
    
  }
  ```
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
