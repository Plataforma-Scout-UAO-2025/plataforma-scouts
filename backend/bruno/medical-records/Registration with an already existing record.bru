meta {
  name: Registration with an already existing record
  type: http
  seq: 9
}

post {
  url: {{baseurl}}api/v1/medical_record/create_record
  body: json
  auth: none
}

body:json {
  {
    "member_id": 456, // miembro con registro ya existente
    "blood_type": "AB+",
    "eps": "Sura",
    "allergies": "Piña",
    "chronic_diseases": "Diabetes",
    "physical_restrictions": "Requiere una silla de ruedas",
    "surgical_history": "Apendicectomía",
    "vaccines_detail": [],
    "medications_detail": []
  }
  
}

tests {
  test("Validar petición fallida", function () {
    expect(res.status).to.equal("400");
  });
  
  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("ERROR: datos inválidos.");
  });
  
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Registro con otro registro ya existente
  
  **Endpoint:** /api/v1/medical_record/create_record
  
  **HU relacionadas:** HU-INN-1.1
  
  **Descripción:** Comprobar que el endpoint de creación de registros medicos recibe y responde correctamente a una petición de un usuario con un registro ya creado.
  
  **Respuesta esperada:** Retorna el código 400 (bad request) y un mensaje de error.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
