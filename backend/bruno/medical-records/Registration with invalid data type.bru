meta {
  name: Registration with invalid data type
  type: http
  seq: 6
}

post {
  url: {{baseurl}}api/v1/medical_record/create_record/21
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-Id: {{tenantId}}
}

body:json {
  {
    "blood_type": "AB+",
    "eps": 1, // dato inválido
    "allergies": "Piña",
    "chronic_diseases": "Diabetes",
    "physical_restrictions": "Requiere una silla de ruedas",
    "surgical_history": "Apendicectomía",
    "vaccines_detail": [],
    "medications_detail": []
  }
  
}

tests {
  test("Validar petición fallida", function () {
    expect(res.status).to.equal(400);
  });
  
  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("ERROR: datos inválidos.");
  });
  
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Registro con tipo de dato inválido
  
  **Endpoint:** /api/v1/medical_record/create_record/{id}
  
  **HU relacionadas:** HU-INN-1.1
  
  **Descripción:** Comprobar que el endpoint de creación de registros medicos recibe y responde correctamente a una petición con campos válidos y valores con tipos inválidos.
  
  **Respuesta esperada:** Retorna el código 400 (bad request) y un mensaje de error.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-08
}
