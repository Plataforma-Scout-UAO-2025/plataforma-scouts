meta {
  name: Successful update
  type: http
  seq: 20
}

put {
  url: {{baseurl}}api/v1/medical_record/update_record
  body: json
  auth: none
}

body:json {
  {
    "member_id": 123,
    "blood_type": "O+", // valor a actualizar
    "eps": "Sura",
    "allergies": "Piña",
    "chronic_diseases": "Diabetes",
    "physical_restrictions": "Requiere una silla de ruedas",
    "surgical_history": "Apendicectomía",
    "vaccines_detail": [{
      "name": "COVID-19 (Pfizer)",
      "date": "2022-04-23T18:25:43.511Z"
    }],
    "medications_detail": [{
      "name": "Aspirina",
      "dose": "50 mg",
      "frecuency": "2 veces al día"
    }]
  }
  
}

tests {
  test("Validar petición exitosa", function () {
    expect(res.status).to.equal("200");
  });
  
  test("Validar mensaje de exito", function () {
    expect(res.body.message).to.equal("Actualización realizada con exito.");
  });
  
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Actualizado exitoso
  
  **Endpoint:** /api/v1/medical_record/update_record
  
  **HU relacionadas:** HU-INN-2.1
  
  **Descripción:** Comprobar que el endpoint de actualizado de registros medicos recibe y responde correctamente a una petición con valores válidos y con la sesión iniciada.
  
  **Respuesta esperada:** Retorna el código 200 y un body con un mensaje de exito.
  
  **Estructura del body de entrada:**
  
  ```
  req.body {
  
    "member_id": bigint,
  
    "blood_type": string,
  
    "eps": string,
    
    "allergies": string,
    
    "chronic_diseases": string,
    
    "physical_restrictions": string,
    
    "surgical_history": string,
    
    "vaccines_detail": [{
      "name": string,
      "date": date
    }],
    
    "medications_detail": [{
      "name": string,
      "frecuency": string
    }]
    
  }
  ```
  
  **Estructura del body de salida:**
  
  ```
  res.body {
  
    "message": string,
  
  }
  ```
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
