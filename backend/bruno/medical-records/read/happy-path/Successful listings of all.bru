meta {
  name: Successful listings of all
  type: http
  seq: 5
}

get {
  url: {{baseurl}}/medical_record/list_by_tenant
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-Id: {{tenantId}}
}

tests {
  test("Validar petición exitosa", function () {
    expect(res.status).to.equal(200);
  });
  
  test("Validar tipos de todos los campos", function () {
    expect(res.body).to.be.a('array').that.is.not.empty;
    
    expect(res.body[0].medical_record_id).to.be.a('bigint');
    expect(res.body[0].member_id).to.be.a('bigint');
  
    expect(res.body[0].blood_type).to.be.a('string');
    expect(res.body[0].eps).to.be.a('string');
    expect(res.body[0].allergies).to.be.a('string');
    expect(res.body[0].chronic_diseases).to.be.a('string');
    expect(res.body[0].physical_restrictions).to.be.a('string');
    expect(res.body[0].surgical_history).to.be.a('string');
  
    expect(res.body[0].active).to.be.a('boolean');
    
    expect(res.body[0].vaccines_detail).to.be.a('array').that.is.not.empty;
    expect(res.body[0].vaccines_detail[0].name).to.be.a('string');
    expect(res.body[0].vaccines_detail[0].date).to.be.a('date');
  
    expect(res.body[0].medications_detail).to.be.a('array').that.is.not.empty;
    expect(res.body[0].medications_detail[0].name).to.be.a('string');
    expect(res.body[0].medications_detail[0].dose).to.be.a('string');
    expect(res.body[0].medications_detail[0].frecuency).to.be.a('string');
  
    expect(res.body[0].created_at).to.be.a('date');
    expect(res.body[0].updated_at).to.be.a('date');
  });
  
  test("Validar campos obligatorios", function () {
    expect(res.body[0].medical_record_id).to.be.at.least(0);
    expect(res.body[0].member_id).to.be.at.least(0);
  
    expect(res.body[0].blood_type).to.equal("AB+");
    expect(res.body[0].eps).to.equal("Sura");
  });
  
  test("Validar campos no obligatorios", function () {
    expect(res.body[0].allergies).to.equal("Piña");
    expect(res.body[0].chronic_diseases).to.equal("Diabetes");
    expect(res.body[0].physical_restrictions).to.equal("Requiere una silla de ruedas");
    expect(res.body[0].surgical_history).to.equal("Apendicectomía");
  
    expect(res.body[0].vaccines_detail).to.be.not.empty;
    expect(res.body[0].vaccines_detail[0]).to.include({name:"COVID-19 (Pfizer)",date:"2022-04-23T18:25:43.511Z"});
  
    expect(res.body[0].medications_detail).to.be.not.empty;
    expect(res.body[0].medications_detail[0]).to.include({name:"Aspirina",dose:"5 mg",frecuency:"2 veces al día"});
  });
  
  test("Validar categorias válidas de tipo de sangre", function () {
    const tiposSangreValidos = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    expect(res.body[0].blood_type).to.be.oneOf(tiposSangreValidos);
  });
  
  test("Validar limite de caracteres", function () {
    expect(res.body[0].eps).to.have.lengthOf.at.most(50);
    expect(res.body[0].allergies).to.have.lengthOf.at.most(1000);
    expect(res.body[0].chronic_diseases).to.have.lengthOf.at.most(1000);
    expect(res.body[0].physical_restrictions).to.have.lengthOf.at.most(1000);
    expect(res.body[0].surgical_history).to.have.lengthOf.at.most(1000);
  
    expect(res.body[0].vaccines_detail).to.be.not.empty;
    expect(res.body[0].vaccines_detail[0].name).to.have.lengthOf.at.most(50);
  
    expect(res.body[0].medications_detail).to.be.not.empty;
    expect(res.body[0].medications_detail[0].name).to.have.lengthOf.at.most(50);
    expect(res.body[0].medications_detail[0].dose).to.have.lengthOf.at.most(100);
    expect(res.body[0].medications_detail[0].frecuency).to.have.lengthOf.at.most(100);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Nombre:** Listado exitoso de todos
  
  **Endpoint:** /api/v1/medical_record/list_record/
  
  **HU relacionadas:** HU-INN-2.1 HU-INN-2.2
  
  **Descripción:** Comprobar que el endpoint de listado de registros medicos recibe y responde correctamente a una petición con valores válidos y por un miembro con los permisos requeridos.
  
  **Respuesta esperada:** Retorna el código 200 y un array con los objetos de registro médico.
  
  **Estructura del body de salida:**
  
  ```
  res.body [{
  
    "id": string,
    
    "tenant_id": string,
    
    "member_id": string,
  
    "blood_type": string,
  
    "eps": string,
    
    "allergies": string,
    
    "chronic_diseases": string,
    
    "physical_restrictions": string,
    
    "surgical_history": string,
    
    "active": bool,
    
    "vaccines_detail": [{
      "name": string,
      "applied_at": string
    }],
    
    "medications_detail": [{
      "name": string,
      "dose": string,
      "frequency": string
    }],
    
    "created_at": date,
    
    "updated_at": date,
    
  }]
  ```
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
