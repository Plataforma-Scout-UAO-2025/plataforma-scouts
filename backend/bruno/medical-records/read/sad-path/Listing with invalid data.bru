meta {
  name: Listing with invalid data
  type: http
  seq: 1
}

get {
  url: {{baseurl}}/medical_record/list_record/no
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-Id: {{tenantId}}
}

tests {
  test("Validar petición fallida", function () {
    expect(res.status).to.equal(400);
  });
  
  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("ERROR: datos inválidos.");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Nombre:** Listado con datos inválidos
  
  **Endpoint:** /api/v1/medical_record/list_record/{id}
  
  **HU relacionadas:** HU-INN-2.1 HU-INN-2.2
  
  **Descripción:** Comprobar que el endpoint de listado de registros medicos recibe y responde correctamente a una petición con datos inválidos.
  
  **Respuesta esperada:** Retorna el código 400 (bad request) y un mensaje de error.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
}
