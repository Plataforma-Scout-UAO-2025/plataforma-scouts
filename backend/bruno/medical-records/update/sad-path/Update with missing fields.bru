meta {
  name: Update with missing fields
  type: http
  seq: 1
}

put {
  url: {{baseurl}}/medical_record/update_record/21
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-Id: {{tenantId}}
}

body:json {
  {
    // campo blood_type faltante
    "eps": "Sura",
    "allergies": "Piña",
    "chronic_diseases": "Diabetes",
    "physical_restrictions": "Requiere una silla de ruedas",
    "surgical_history": "Apendicectomía",
    "vaccines_detail": [],
    "medications_detail": []
  }
  
}

tests {
  test("Validar petición fallida", function () {
    expect(res.status).to.equal(400);
  });
  
  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("ERROR: campos faltantes.");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Nombre:** Actualizado con campos faltantes
  
  **Endpoint:** /api/v1/medical_record/update_record
  
  **HU relacionadas:** HU-INN-2.1
  
  **Descripción:** Comprobar que el endpoint de actualizado de registros medicos recibe y responde correctamente a una petición con campos faltantes.
  
  **Respuesta esperada:** Retorna el código 400 (bad request) y un mensaje de error.
  
  **Responsable:** Camilo Franco Moya
  
  **Última Actualización:** 2025-10-01
  
}
