meta {
  name: 6) CreatePago - Method tipo inválido (numérico)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/finanzas/payments/org_6B3k4dao2Wf6eGxa/installments/302/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
      "payment_id": "0aa9698a-92c0-4fa7-955c-043690822ae6",
      "installment_id": 302,
      "payer_member_id": 61,
      "paid_at": "2025-10-23",
      "method": 123,
      "reference": "asdas",
      "amount": 15000
    }
}

tests {
  test('Status code expected', () => {
    expect([400]).to.include(res.status);
  });
  
  // Validar que la respuesta es JSON válido (si no es 204)
  test('Response is JSON or empty (204)', () => {
    if (res.status !== 204) {
      expect(res.body).to.be.an('object');
    }
  });
  
  // Validar presencia de mensaje de error en negativos
  test('Response contains message', () => {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.be.a('string').and.not.empty;
  });
  
  // Log del resultado
  test('Log', () => {
    console.log('Nombre del caso: 6) CreatePago - Method tipo inválido (numérico)');
    console.log('Status:', res.status);
    console.log('Body:', JSON.stringify(res.body));
    expect(true).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  # 📋 Caso 6: Crear Pago - Method Tipo Inválido (Numérico)
  
  ## 🎯 Objetivo
  Verificar que el sistema rechaza la creación de pagos cuando el campo method tiene un tipo de dato inválido (number en lugar de string).
  
  ## 📍 Endpoint
  ```
  POST {{baseUrl}}/api/{{apiVersion}}/finanzas/payments/org_6B3k4dao2Wf6eGxa/installments/300/payments
  ```
  
  ## 📦 Request Body
  ```json
  {
    "payment_id": "0aa9698a-92c0-4fa7-955c-043690822ae6",
    "installment_id": 300,
    "payer_member_id": 61,
    "paid_at": "2025-10-23",
    "method": 123,  // ❌ Debe ser string, no número
    "reference": "asdas",
    "amount": 15000
  }
  ```
  
  ## ❌ Respuesta Esperada
  - **Status Code:** `400 Bad Request`
  - **Body:** Mensaje de error indicando que el tipo de dato es inválido
  
  ```json
  {
    "message": "El campo method debe ser string",
    "field": "method"
  }
  ```
  
  ## 🔗 Historia de Usuario
  **HU-FIN-1.2** - Gestión de Pagos
  
  ## 👤 Responsable
  Edwin
  
  ## 📅 Última Actualización
  2025-10-07
}
