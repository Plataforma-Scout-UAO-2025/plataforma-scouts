meta {
  name: 13) GetEstadoCuenta Tesorero - con tenant_id invalido
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/finanzas/payments/status/org_6B3k4dao2Wf6eGxaaaaaaaa
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

tests {
  test('Status code expected', () => {
    expect([404, 400]).to.include(res.status);
  });

  // Validar que la respuesta es JSON válido (si no es 204)
  test('Response is JSON or empty (204)', () => {
    if (res.status !== 204) {
      expect(res.body).to.be.an('object');
    }
  });

  // Validar presencia de mensaje de error en negativos
  test('Response contains message', () => {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.be.a('string').and.not.empty;
  });

  // Log del resultado
  test('Log', () => {
    console.log('Nombre del caso: 13) GetEstadoCuenta Tesorero - con tenant_id invalido');
    console.log('Status:', res.status);
    console.log('Body:', JSON.stringify(res.body));
    expect(true).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  # 📋 Caso 13: Obtener Estado de Cuenta Tesorero - Tenant ID Inválido

  ## 🎯 Objetivo
  Verificar que el sistema devuelve un error apropiado al intentar consultar el estado de cuenta con un tenant_id inválido.

  ## 📍 Endpoint
  ```
  GET {{baseUrl}}/api/{{apiVersion}}/finanzas/payments/status/org_6B3k4dao2Wf6eGxaaaaaaaa
  ```
  **Nota:** Tenant ID inválido `org_6B3k4dao2Wf6eGxaaaaaaaa`

  ## 📦 Request Body
  N/A (método GET no requiere body)

  ## ❌ Respuesta Esperada
  - **Status Code:** `404 Not Found` o `400 Bad Request`
  - **Body:** Mensaje de error indicando que el tenant no existe

  ```json
  {
    "message": "Tenant not found"
  }
  ```

  ## 🔗 Historia de Usuario
  **HU-FIN-1.2** - Gestión de Pagos

  ## 👤 Responsable
  Edwin

  ## 📅 Última Actualización
  2025-10-07
}
