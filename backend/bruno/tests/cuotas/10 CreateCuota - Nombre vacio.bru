meta {
  name: 10) CreateCuota - Periodicidad no permitida (BYMONTHLY)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/finanzas/fees
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "tenant_id": "org_6B3k4dao2Wf6eGxa",
    "name": "Cuota mensual scout",
    "description": "Pago mensual de actividades",
    "amount": 50000,
    "periodicity": "BYMONTHLY",
    "scope": "SCOUT",
    "start_date": "2025-01-01",
    "end_date": "2026-06-01",
    "associated_to": {
      "id": 37,
      "name": "Esteban Torres"
    }
  }
}

tests {
  test('Status code expected', () => {
    expect([400,422]).to.include(res.status);
  });
  
  // Validar que la respuesta es JSON válido (si no es 204)
  test('Response is JSON or empty (204)', () => {
    if (res.status !== 204) {
      expect(res.body).to.be.an('object');
    }
  });
  
  // Validar presencia de mensaje de error en negativos
  test('Response contains message', () => {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.be.a('string').and.not.empty;
  });
  
  // Log del resultado
  test('Log', () => {
    console.log('Nombre del caso: 10) CreateCuota - Periodicidad no permitida (BYMONTHLY)');
    console.log('Status:', res.status);
    console.log('Body:', JSON.stringify(res.body));
    expect(true).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  # 📋 Caso 10: Crear Cuota - Periodicidad NO Permitida (BYMONTHLY)

  ## 🎯 Objetivo
  Verificar que el sistema rechaza valores de periodicidad no permitidos, como 'BYMONTHLY'.

  ## 📍 Endpoint
  ```
  POST {{baseUrl}}/api/{{apiVersion}}/finanzas/fees
  ```

  ## 📦 Request Body
  ```json
  {
    "tenant_id": "org_6B3k4dao2Wf6eGxa",
    "name": "Cuota mensual scout",
    "description": "Pago mensual de actividades",
    "amount": 50000,
    "periodicity": "BYMONTHLY",  // ❌ Valor no permitido
    "scope": "SCOUT",
    "start_date": "2025-01-01",
    "end_date": "2026-06-01",
    "associated_to": {
      "id": 37,
      "name": "Esteban Torres"
    }
  }
  ```

  ## ❌ Respuesta Esperada
  - **Status Code:** `400 Bad Request` o `422 Unprocessable Entity`
  - **Body:** Mensaje de error indicando que la periodicidad no es válida

  ```json
  {
    "message": "Periodicidad no permitida. Valores válidos: MONTH, QUARTER, etc.",
    "field": "periodicity"
  }
  ```

  ## 🔗 Historia de Usuario
  **HU-FIN-1.1** - Gestión de Cuotas

  ## 👤 Responsable
  Edwin

  ## 📅 Última Actualización
  2025-10-07
}
