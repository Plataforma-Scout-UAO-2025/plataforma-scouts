meta {
  name: 4) CreateCuota - Monto tipo inválido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/finanzas/fees
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "tenant_id": "org_6B3k4dao2Wf6eGxa",
    "name": "Cuota mensual scout",
    "description": "Pago mensual de actividades",
    "amount": "quince mil",
    "periodicity": "MONTH",
    "scope": "SCOUT",
    "start_date": "2025-01-01",
    "end_date": "2025-06-01",
    "associated_to": {
      "id": 29,
      "name": "Sebastian Cruz"
    }
  }
}

tests {
  test('Status code expected', () => {
    expect([400]).to.include(res.status);
  });
  
  // Validar que la respuesta es JSON válido (si no es 204)
  test('Response is JSON or empty (204)', () => {
    if (res.status !== 204) {
      expect(res.body).to.be.an('object');
    }
  });
  
  // Validar presencia de mensaje de error en negativos
  test('Response contains message', () => {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.be.a('string').and.not.empty;
  });
  
  // Log del resultado
  test('Log', () => {
    console.log('Nombre del caso: 4) CreateCuota - Monto tipo inválido');
    console.log('Status:', res.status);
    console.log('Body:', JSON.stringify(res.body));
    expect(true).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  # 📋 Caso 4: Crear Cuota - Monto Tipo Inválido (Texto)
  
  ## 🎯 Objetivo
  Verificar que el sistema rechaza la creación de cuotas cuando el campo `amount` tiene un tipo de dato inválido (string en lugar de number).
  
  ## 📍 Endpoint
  ```
  POST {{baseUrl}}/api/{{apiVersion}}/finanzas/cuotas
  ```
  
  ## 📦 Request Body
  ```json
  {
    "tenant_id": 1,
    "name": "Test Monto Texto",
    "description": "Validación tipo inválido",
    "amount": "quince mil",  // ❌ Debe ser número, no texto
    "periodicity": "MONTH",
    "scope": "ALL",
    "start_date": "2025-10-01",
    "end_date": "2026-01-30"
  }
  ```
  
  ## ❌ Respuesta Esperada
  - **Status Code:** `400 Bad Request`
  - **Body:** Mensaje de error indicando que el tipo de dato es inválido
  
  ```json
  {
    "message": "El campo amount debe ser numérico",
    "field": "amount"
  }
  ```
  
  ## 🔗 Historia de Usuario
  **HU-FIN-1.1** - Gestión de Cuotas
  
  ## 👤 Responsable
  Edwin
  
  ## 📅 Última Actualización
  2025-10-04
}
