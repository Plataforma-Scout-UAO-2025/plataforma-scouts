tests {
  test('Status code expected', () => {
    expect([400]).to.include(res.status);
  });
  
  // Validar que la respuesta es JSON válido (si no es 204)
  test('Response is JSON or empty (204)', () => {
    if (res.status !== 204) {
      expect(res.body).to.be.an('object');
    }
  });
  
  // Validar presencia de mensaje de error en negativos
  test('Response contains message', () => {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.be.a('string').and.not.empty;
  });
  
  // Log del resultado
  test('Log', () => {
    console.log('Nombre del caso: 19) UpdateCuota - Formato de fecha inválido');
    console.log('Status:', res.status);
    console.log('Body:', JSON.stringify(res.body));
    expect(true).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  # 📋 Caso 19: Actualizar Cuota - Formato de Fecha Inválido
  
  ## 🎯 Objetivo
  Verificar que el sistema rechaza actualizaciones con fechas en formato incorrecto (usando '/' en lugar de '-').
  
  ## 📍 Endpoint
  ```
  PUT {{baseUrl}}/api/{{apiVersion}}/finanzas/cuotas/{{idCuota}}
  ```
  
  ## 📦 Request Body
  ```json
  {
    "name": "Mensualidad",
    "description": "Validación fecha",
    "amount": 50000,
    "periodicity": "MONTH",
    "scope": "ALL",
    "start_date": "2025-10-01",
    "end_date": "2026/02/28"  // ❌ Formato incorrecto (debe ser YYYY-MM-DD)
  }
  ```
  
  ## ❌ Respuesta Esperada
  - **Status Code:** `400 Bad Request`
  - **Body:** Mensaje de error indicando que el formato de fecha es inválido
  
  ```json
  {
    "message": "Formato de fecha inválido. Use YYYY-MM-DD",
    "field": "end_date"
  }
  ```
  
  ## 🔗 Historia de Usuario
  **HU-FIN-1.1** - Gestión de Cuotas
  
  ## 👤 Responsable
  Edwin
  
  ## 📅 Última Actualización
  2025-10-04
}
