meta {
  name: SCOUT-BlockedFromAdminAction
  type: http
  seq: 8
}

post {
  url: {{baseurl}}api/v1/tenants
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tenantSlug": "unauthorized-tenant",
    "name": "Unauthorized Tenant"
  }
}

tests {
  test("Validar petición bloqueada", function () {
    // Puede ser 401 (no autenticado) o 403 (no autorizado)
    expect([401, 403]).to.include(res.status);
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  **Nombre:** SCOUT intenta crear recurso administrativo
  
  **Endpoint:** /api/v1/tenants (POST)
  
  **HU relacionadas:** HU-ING-1.2
  
  **Criterio de aceptación:** Si un usuario intenta acceder a funciones fuera de su rol, el sistema debe bloquear la acción y mostrar "Acceso denegado".
  
  **Descripción:** Dado que estoy autenticado como SCOUT, cuando intento ejecutar una acción administrativa (crear tenant), entonces el backend debe bloquearla.
  
  **Respuesta esperada:** Respuesta 403 con mensaje "Acceso denegado" y operación no realizada.
  
  **Responsable:** QA Team
  
  **Última Actualización:** 2025-10-14
  
}
