meta {
  name: Get File URL - Images
  type: http
  seq: 6
}

get {
  url: {{baseurl}}api/v1/test/file-url?fileName=sample-image.jpg&bucket=images
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has correct structure", function() {
    const body = res.getBody();
    expect(body).to.have.property('fileName', 'sample-image.jpg');
    expect(body).to.have.property('bucket', 'images');
    expect(body).to.have.property('fileUrl');
  });
  
  test("File URL is valid", function() {
    const body = res.getBody();
    expect(body.fileUrl).to.be.a('string');
    expect(body.fileUrl).to.contain('storage/v1/object/public/images/sample-image.jpg');
  });
}

docs {
  Nombre: Obtener URL de acceso a imagen
  Endpoint: /api/v1/test/file-url
  HU relacionadas: 
  Descripción: Test que verifica la generación correcta de URLs de acceso para archivos de imagen
  Respuesta esperada: Status 200 con información del archivo y URL de acceso válida
  Estructura del body de salida: {fileName: string, bucket: string, fileUrl: string}
  Responsable: Alejandro Bravo
  Última Actualización: 2025-09-23
}