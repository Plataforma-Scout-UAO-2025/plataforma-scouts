meta {
  name: Get File URL - Images
  type: http
  seq: 6
}

get {
  url: {{baseurl}}api/v1/test/file-url?fileName=sample-image.jpg&bucket=images
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has correct structure", function() {
    const body = res.getBody();
    expect(body).to.have.property('fileName', 'sample-image.jpg');
    expect(body).to.have.property('bucket', 'images');
    expect(body).to.have.property('fileUrl');
  });
  
  test("File URL is valid", function() {
    const body = res.getBody();
    expect(body.fileUrl).to.be.a('string');
    expect(body.fileUrl).to.contain('storage/v1/object/public/images/sample-image.jpg');
  });
}