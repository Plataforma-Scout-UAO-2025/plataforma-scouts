meta {
  name: Upload Document - Success
  type: http
  seq: 4
}

post {
  url: {{baseurl}}api/v1/test/upload/document
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  file: @file(./test-files/sample-document.pdf)
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has correct structure", function() {
    const body = res.getBody();
    expect(body).to.have.property('message', 'Archivo subido exitosamente');
    expect(body).to.have.property('fileName');
    expect(body).to.have.property('originalName');
    expect(body).to.have.property('fileUrl');
    expect(body).to.have.property('bucket', 'files');
    expect(body).to.have.property('size');
    expect(body).to.have.property('contentType');
  });
  
  test("File name is generated correctly", function() {
    const body = res.getBody();
    expect(body.fileName).to.contain('sample-document.pdf');
    expect(body.originalName).to.equal('sample-document.pdf');
  });
  
  test("File URL is valid", function() {
    const body = res.getBody();
    expect(body.fileUrl).to.be.a('string');
    expect(body.fileUrl).to.contain('storage/v1/object/public/files/');
  });
  
  test("Content type is document", function() {
    const body = res.getBody();
    expect(body.contentType).to.contain('application/pdf');
  });
  
  test("File size is positive", function() {
    const body = res.getBody();
    expect(body.size).to.be.greaterThan(0);
  });
}