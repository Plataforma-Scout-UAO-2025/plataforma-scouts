meta {
  name: Upload Image - Empty File
  type: http
  seq: 3
}

post {
  url: {{baseurl}}api/v1/test/upload/image
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  file: @file(./test-files/empty-file.txt)
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("Error response has correct structure", function() {
    const body = res.getBody();
    expect(body).to.have.property('error', 'El archivo está vacío');
    expect(body).to.have.property('statusCode', 400);
    expect(body).to.have.property('details', 'No se puede procesar un archivo vacío');
    expect(body).to.have.property('timestamp');
  });
  
  test("Timestamp is valid ISO format", function() {
    const body = res.getBody();
    expect(body.timestamp).to.be.a('string');
    expect(new Date(body.timestamp)).to.be.instanceOf(Date);
  });
}

docs {
  Nombre: Validación de error al subir imagen vacía
  Endpoint: /api/v1/test/upload/image
  HU relacionadas: 
  Descripción: Test que verifica el manejo correcto de errores cuando se intenta subir un archivo vacío
  Respuesta esperada: Status 400 con mensaje de error específico y timestamp
  Estructura del body de salida: {error: string, statusCode: number, details: string, timestamp: string}
  Responsable: Alejandro Bravo
  Última Actualización: 2025-09-23
}