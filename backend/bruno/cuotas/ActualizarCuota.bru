meta {
  name: ActualizarCuota
  type: http
  seq: 3
}

patch {
  url: http://localhost:8080/api/v1/finanzas/fees/1/17
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 15000,
    "name": "Mensualidad",
    "description": "Mensualidad proximos meses"
  }
}

settings {
  encodeUrl: true
}

docs {
  "/api/v1/finanzas/fees/{tenantId}/{feePlanId}"
  
  Solo permite actualizar los valores de amount, name y description. Para cambios en los otros atributos se debe crear otro registro. Esto es por los calculos que se hacen a la hora de crear el plan.
}
