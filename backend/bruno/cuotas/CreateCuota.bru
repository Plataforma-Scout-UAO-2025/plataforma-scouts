meta {
  name: CreateCuota
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/finanzas/fees
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "tenant_id": "3263470f-eb40-4e86-b4fb-8d2c111348d0",
    "name": "Cuota mensual scout",
    "description": "Pago mensual de actividades",
    "amount": 50000,
    "periodicity": "MONTH",
    "scope": "SCOUT",
    "start_date": "2025-01-01",
    "end_date": "2025-06-01",
    "associated_to": {
      "id": "72b0e16c-84d4-4e49-838b-d473e2e000b0",
      "name": "Camila Mendoza"
    }
  }
}

settings {
  encodeUrl: true
}

docs {
  
    "tenant_id": BigINT,
    
    "amount": numeric,
    
    "name": text,
    
    "description": text,
    
    "periodicity": text = "SINGLE" | "MONTH" | "QUARTER" | "YEAR",
    
    "scope": text ="ALL" | "SCOUT" | "SUBGROUP" | "SECTION",
    
    "start_date": LocalDate,
    
    "end_date": LocalDate,
    
    "member": BigINT -> NULLABLE if scope ≠ "SCOUT",
    
    "subgroup_id": BigINT -> NULLABLE if scope ≠ "SUBGROUP",
          
    "section_id": BigINT -> NULLABLE if scope ≠ "SECTION",
    
}
