meta {
  name: Get Groups most-members tenant mismatch
  type: http
  seq: 9
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups/most-members
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Tenant-Id: otra_tenant
}

tests {
  test("Validar código de error por tenant mismatch", function () {
    expect(res.status).to.equal(403);
  });

  test("Validar mensaje de error", function () {
    expect(res.body.message).to.be.a('string');
    expect(res.body.message).to.equal('Tenant mismatch or no permissions');
  });
}

settings {
  encodeUrl: true
}
