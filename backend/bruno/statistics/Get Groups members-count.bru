meta {
  name: Get Groups members-count
  type: http
  seq: 1
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups/members-count
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Tenant-Id: org_6B3k4dao2Wf6eGxa
}

tests {
  test("Validar petición exitosa", function () {
    expect(res.status).to.equal(200);
  });

  test("Validar estructura de cada elemento en el array", function () {
    expect(res.body).to.be.an('array');
    if (res.body.length > 0) {
      const firstItem = res.body[0];
      expect(firstItem).to.have.property('groupId');
      expect(firstItem).to.have.property('groupName');
      expect(firstItem).to.have.property('memberCount');
      expect(firstItem.memberCount).to.be.a('number');
      expect(firstItem.memberCount).to.be.at.least(0);
    }
  });
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Obtener cantidad de miembros por grupo (caso exitoso)
  
  **Endpoint:** /api/v1/tenants/{tenantId}/statistics/groups/members-count
  
  **Descripción:** Validar que el endpoint retorna correctamente el conteo de miembros por grupo para un tenant.
  Se envía el header X-Tenant-Id correcto y se espera:
  - Código 200
  - Array de objetos con groupId, groupName y memberCount
  - memberCount debe ser numérico >= 0
  - Estructura JSON correcta
}