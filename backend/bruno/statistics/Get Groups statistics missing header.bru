meta {
  name: Get Groups statistics - missing header
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

settings {
  encodeUrl: true
}

tests {
  test("Validar código de error por falta de header", function () {
    expect(res.status).to.equal(401);
  });

  test("Validar mensaje de error", function () {
    expect(res.body.message).to.equal("Missing X-Tenant-Id header");
  });
}

docs {
  **Nombre:** Obtener estadísticas de grupos - Sin header de autenticación
  
  **Endpoint:** /api/v1/tenants/{tenantId}/statistics/groups
  
  **HU relacionadas:** HU-STATS-1.1
  
  **Descripción:** Validar que el endpoint requiere el header X-Tenant-Id.
  Se envía la petición sin el header X-Tenant-Id y se espera:
  - Código 401 (Unauthorized)
  - Mensaje de error indicando que falta el header
  
  **Respuesta esperada:**
  ```json
  {
    "message": "Missing X-Tenant-Id header"
  }
  ```
  
  **Última Actualización:** 2025-10-27
}
