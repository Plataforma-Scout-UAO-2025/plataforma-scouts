meta {
  name: Get Groups members-count missing header
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups/members-count
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

tests {
  test("Validar código de respuesta no autorizado", function () {
    expect(res.status).to.equal(401);
  });

  test("Validar mensaje de error", function () {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.equal('Missing X-Tenant-Id header');
  });
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Obtener cantidad de miembros por grupo (header faltante)
  
  **Endpoint:** /api/v1/tenants/{tenantId}/statistics/groups/members-count
  
  **Descripción:** Validar que el endpoint retorna error cuando falta el header X-Tenant-Id.
  No se envía el header X-Tenant-Id y se espera:
  - Código 401
  - Mensaje de error por header faltante
}