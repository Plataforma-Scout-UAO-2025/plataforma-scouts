meta {
  name: Get Groups most-members missing header
  type: http
  seq: 8
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups/most-members
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

tests {
  test("Validar código de error por falta de header", function () {
    expect(res.status).to.equal(401);
  });

  test("Validar mensaje de error", function () {
    expect(res.body.message).to.be.a('string');
    expect(res.body.message).to.equal('Missing X-Tenant-Id header');
  });
}

settings {
  encodeUrl: true
}

