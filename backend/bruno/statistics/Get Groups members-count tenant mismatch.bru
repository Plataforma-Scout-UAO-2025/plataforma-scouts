meta {
  name: Get Groups members-count tenant mismatch
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/v1/tenants/org_6B3k4dao2Wf6eGxa/statistics/groups/members-count
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Tenant-Id: org_diferente
}

tests {
  test("Validar código de respuesta no autorizado", function () {
    expect(res.status).to.equal(403);
  });

  test("Validar mensaje de error", function () {
    expect(res.body).to.have.property('message');
    expect(res.body.message).to.equal('Tenant mismatch or no permissions');
  });
}

settings {
  encodeUrl: true
}

docs {
  **Nombre:** Obtener cantidad de miembros por grupo (tenant mismatch)
  
  **Endpoint:** /api/v1/tenants/{tenantId}/statistics/groups/members-count
  
  **Descripción:** Validar que el endpoint retorna error cuando el tenant del header no coincide.
  Se envía un header X-Tenant-Id diferente al de la URL y se espera:
  - Código 403
  - Mensaje de error por tenant mismatch
}