meta {
  name: Create Group - Invalid Slug Format
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/v1/tenants/t-bruno-success-slugv04/groups/create
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body {
  {
    "slug": "grupo con espacios!",
    "name": "Grupo Scout con Slug Inválido",
    "tenant_id": "t-bruno-success-slugv04",
    "status": "active",
    "is_active": true,
    "district": "Distrito de prueba",
    "identifier_number": "004",
    "address": "Dirección de prueba",
    "phone": "1234567890",
    "email": "grupo.invalido@scouts.org"
  }
}

tests {
  test("Validar error por slug inválido", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property('error').that.equals('Bad Request');
    expect(res.body).to.have.property('message');
    const message = res.body.message.toLowerCase();
    expect(message).to.include('slug');
    expect(message).to.include('inválido');
  });

  test("Validar estructura del error", function() {
    expect(res.body).to.have.property('timestamp');
    expect(res.body).to.have.property('path');
    expect(res.body).to.have.property('status').that.equals(400);
  });
}

docs {
  **Nombre:** Crear grupo - validación de formato de slug
  
  **Endpoint:** `/api/v1/tenants/{tenantId}/groups/create`
  
  **Descripción:** Validar que el endpoint rechaza la creación cuando el slug tiene formato inválido.
  Se espera:
  - Código 400 (Bad Request)
  - Mensaje de error indicando formato inválido
  - Estructura de error correcta
}