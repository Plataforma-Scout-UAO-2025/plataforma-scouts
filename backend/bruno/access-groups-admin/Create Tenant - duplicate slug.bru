meta {
  name: Create Tenant - duplicate slug
  type: http
  seq: 6
}

post {
  url: http://localhost:8080/api/v1/tenants/create
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

tests {
  test("Validar código y estructura del error", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property('status').that.equals(400);
    expect(res.body).to.have.property('error').that.equals('Bad Request');
    expect(res.body).to.have.property('path').that.equals('/api/v1/tenants/create');
  });

  test("Validar mensaje de error", function() {
    expect(res.body).to.have.property('message');
    const message = res.body.message;
    expect(message).to.include("already exists");
    expect(message).to.include("Tenant with slug");
  });

  test("Validar campos de error adicionales", function() {
    expect(res.body).to.have.property('timestamp');
  });
}

docs {
  **Nombre:** Crear tenant - validación de slug duplicado
  
  **Endpoint:** /api/v1/tenants/create
  
  **Descripción:** Validar que el endpoint rechaza la creación cuando el slug ya existe.
  Se espera:
  - Código 400
  - Mensaje de error de duplicado
  - Estructura de error correcta
}

body {
  {
    "tenant_id": "bruno-info-slugv01",
    "slug": "bruno-info-slugv01",
    "status": "active"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
