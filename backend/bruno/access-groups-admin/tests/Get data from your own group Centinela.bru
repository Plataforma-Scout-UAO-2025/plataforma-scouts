meta {
  name: Get Group By Slug - Own Group (Centinelas 113)
  type: http
  seq: 1
}

get {
  url: {{baseurl}}api/v1/tenants/org_6B3k4dao2Wf6eGxa/groups/grupo-scout-centinelas-113
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: {{token_centinelas}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains expected group", function() {
    const body = res.getBody();
    // El controlador devuelve un objeto GroupResponseDTO
    expect(body).to.have.property('tenant_id', 'org_6B3k4dao2Wf6eGxa');
    expect(body).to.have.property('slug', 'grupo-scout-centinelas-113');
    
  });

  test("Response has required fields", function() {
    const body = res.getBody();
    expect(body).to.have.property('groud_id);
    expect(body).to.have.property('name');
    expect(body).to.have.property('identifier_number');
  });
}

docs {
  Nombre: Obtener datos de grupo propio (Centinelas 113)
  Endpoint: /api/v1/tenants/{tenantId}/groups/{groupSlug}
  HU relacionada: HU-ING-1.3 (Criterio 1)
  Descripción: Valida que el administrador del grupo Centinelas 113 pueda obtener los datos de su propio grupo.
  Respuesta esperada: Status 200 y objeto GroupResponseDTO con slug 'grupo-scout-centinelas-113', tenant_id 'org_6B3k4dao2Wf6eGxa' y propiedades basicas del grupo.
  Responsable: Kelvin Martinez
  Última Actualización: 2025-10-27
}
