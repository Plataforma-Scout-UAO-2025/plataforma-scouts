meta {
  name: Patch - Edit Group - attributes
  type: http
  seq: 10
}

patch {
  url: http://localhost:8080/api/v1/tenants/t-bruno-success-slugv04/groups/bruno-info-slugv06
  body: json
}

headers {
  Content-Type: application/json
  Accept: application/json
}

tests {
  test("DEBUG - response", function() {
    console.log('DEBUG RESPONSE STATUS:', res.status);
    console.log('DEBUG RESPONSE BODY:', JSON.stringify(res.body));
  });
  test("Editar atributos permitidos: name y district", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property('name').that.equals('Nombre Editado');
    expect(res.body).to.have.property('district').that.equals('Distrito Nuevo');
  });
}

docs {
  **Nombre:** Editar atributos de grupo
  **Endpoint:** PATCH /api/v1/tenants/{tenantId}/groups/{slug}
  **Descripción:** Modificar campos permitidos (name, district, phone, etc.)
}

body {
  {
  "name": "Nombre v1Editado",
