tests {
  test("DEBUG - response", function() {
    console.log('DEBUG RESPONSE STATUS:', res.status);
    console.log('DEBUG RESPONSE BODY:', JSON.stringify(res.body));
  });
  test("Intentar editar tenantId (inmutable)", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property('message');
    const msg = res.body.message.toLowerCase();
    expect(msg).to.satisfy(function(m) { return m.includes('tenantid') && m.includes('inmutable'); });
  });
}

docs {
  **Nombre:** Editar tenantId (inmutable)
  **Endpoint:** PATCH /api/v1/tenants/{tenantId}/groups/{slug}
  **Descripción:** Intentar modificar tenantId desde el body no está permitido; se espera error 400.
