meta {
  name: Create Tenant - validation blank slug
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/api/v1/tenants/create
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

tests {
  test("Validar error por slug en blanco", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property('message');
    const message = res.body.message.toLowerCase();
    expect(message).to.satisfy((msg) => 
      msg.includes('error de validación') || 
      msg.includes('must not be blank') || 
      msg.includes('bad request')
    );
  });

  test("Validar estructura del error", function() {
    expect(res.body).to.have.property('message');
    expect(res.body).to.have.property('timestamp');
  });
}

docs {
  **Nombre:** Crear tenant - validación de slug en blanco
  
  **Endpoint:** /api/v1/tenants/create
  
  **Descripción:** Validar que el endpoint rechaza la creación cuando el slug está en blanco.
  Se espera:
  - Código 400
  - Mensaje de error apropiado
  - Estructura de error correcta
}

body {
  {
    "tenant_id": "t-blank",
    "slug": "   ",
    "status": "active"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
